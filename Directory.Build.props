<Project>

  <PropertyGroup Label="Linguagem e plataforma">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="Qualidade: avisos são erros">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Avisos de vulnerabilidade de pacote não derrubam o build; o CI confere com o comando dotnet list package e a opção vulnerable. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Versão">
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Label="Build reproduzível">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup Label="StyleCop: documentação XML obrigatória">
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

</Project>
