# Modelo de variáveis de ambiente da stack local (docker compose).
# Copie para deploy/.env e troque os valores, ou rode `pwsh ./scripts/gerar-env.ps1`, que cria o .env com segredos aleatórios.
# O arquivo .env NÃO vai para o Git. Nenhum valor abaixo serve fora do ambiente de desenvolvimento.

# --- Bancos e broker ---
POSTGRES_USUARIO=conexao
POSTGRES_SENHA=troque-esta-senha
MONGO_USUARIO=conexao
MONGO_SENHA=troque-esta-senha
RABBITMQ_USUARIO=conexao
RABBITMQ_SENHA=troque-esta-senha

# --- Identity.Api ---
# Chave HMAC do hash do e-mail e chaves do CPF: 32 bytes em Base64 cada (ex.: [Convert]::ToBase64String([RandomNumberGenerator]::GetBytes(32))).
AUTENTICACAO_CHAVE_HASH_EMAIL=
CPF_CHAVE_CIFRA=
CPF_CHAVE_HASH=
CPF_VERSAO_CHAVE=1
# Par RSA do JWT (RS256) em PEM, numa linha só com \n no lugar das quebras de linha. A pública vai também para a Campanhas.Api.
JWT_CHAVE_PRIVADA_PEM=
JWT_CHAVE_PUBLICA_PEM=
JWT_ISSUER=conexao-identity
JWT_AUDIENCE=conexao-api
LGPD_VERSAO_POLITICA=2026-10

# --- Gestor da ONG criado na primeira subida ---
SEED_GESTOR_EMAIL=gestor@esperancasolidaria.org
SEED_GESTOR_SENHA=troque-esta-senha

# --- Portas expostas no host ---
PORTA_WEB=8080
PORTA_IDENTITY=8081
PORTA_CAMPANHAS=8082
