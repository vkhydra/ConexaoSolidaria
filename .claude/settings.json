{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "português do Brasil",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "enabledMcpjsonServers": [
    "microsoft-learn",
    "github",
    "playwright"
  ],
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet list package *)",
      "Bash(dotnet reportgenerator *)",
      "Bash(dotnet ef migrations list *)",
      "Bash(dotnet ef migrations script *)",
      "Bash(pwsh ./scripts/verificar-cobertura.ps1 *)",
      "Bash(pwsh ./scripts/verificar-pre-requisitos.ps1)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl kustomize *)",
      "Bash(kubectl apply -k * --dry-run=server)",
      "Bash(helm list *)",
      "Bash(docker ps *)",
      "Bash(minikube status)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet format *)",
      "PowerShell(dotnet restore *)",
      "PowerShell(dotnet tool restore)",
      "PowerShell(pwsh ./scripts/verificar-cobertura.ps1 *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(kubectl get *)",
      "PowerShell(kubectl describe *)",
      "PowerShell(kubectl logs *)",
      "mcp__microsoft-learn"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl rollout *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(docker compose *)",
      "Bash(minikube delete *)",
      "Bash(az *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "PowerShell(git push *)",
      "PowerShell(git rebase *)",
      "PowerShell(kubectl apply *)",
      "PowerShell(kubectl delete *)",
      "PowerShell(az *)"
    ],
    "deny": [
      "Read(./deploy/.env)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets.json)",
      "Read(./**/local.settings.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --no-verify *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(rm -rf *)",
      "PowerShell(git push --force *)",
      "PowerShell(git commit --no-verify *)"
    ]
  }
}
