# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,md,csproj,props,targets,slnx,xml,razor,css,js,feature}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab

# ------------------------------------------------------------------------------
# C#
# ------------------------------------------------------------------------------
[*.cs]

# Organização do código
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0005.severity = warning

# Chaves sempre
csharp_prefer_braces = true:warning

# var quando o tipo é evidente
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Sem this.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Nomes: campos privados em _camelCase
dotnet_naming_rule.campos_privados_com_underscore.symbols = campos_privados
dotnet_naming_rule.campos_privados_com_underscore.style = underscore_camel_case
dotnet_naming_rule.campos_privados_com_underscore.severity = warning
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Interfaces começam com I
dotnet_naming_rule.interfaces_com_i.symbols = interfaces
dotnet_naming_rule.interfaces_com_i.style = prefixo_i
dotnet_naming_rule.interfaces_com_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefixo_i.required_prefix = I
dotnet_naming_style.prefixo_i.capitalization = pascal_case

# ------------------------------------------------------------------------------
# Analisadores
# ------------------------------------------------------------------------------

# Registro com LoggerMessage é otimização, não regra do projeto
dotnet_diagnostic.CA1848.severity = none
# Texto em português: não exigir recursos de localização
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1308.severity = none

# Código gerado (migrations e snapshots do EF Core) fora das regras
[**/Migrations/*.cs]
generated_code = true

# Testes: nomes no padrão Metodo_Cenario_Resultado usam sublinhado
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none
